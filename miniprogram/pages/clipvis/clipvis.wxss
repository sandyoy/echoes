/* pages/clipvis/clipvis.wxss —— 哪段能给别人看（大字版友好） */
.container { padding: 32rpx 28rpx 80rpx; }

.page-title { font-size: 44rpx; font-weight: 600; margin-bottom: 8rpx; }
.page-sub { font-size: 28rpx; color: #888; margin-bottom: 24rpx; }

.tip {
  font-size: 30rpx;
  line-height: 1.7;
  color: #555;
  background: #f6f6f6;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 28rpx;
}

.err { font-size: 32rpx; color: #c0392b; padding: 24rpx 0; line-height: 1.6; }
.loading, .empty { font-size: 32rpx; color: #888; padding: 40rpx 0; line-height: 1.7; }

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #eee;
}
.row-main { flex: 1; padding-right: 24rpx; min-width: 0; }
.row-kind { font-size: 26rpx; color: #999; margin-bottom: 8rpx; }
.row-text {
  font-size: 34rpx;
  line-height: 1.5;
  color: #222;
  word-break: break-all;
}

.switch {
  flex-shrink: 0;
  min-width: 168rpx;
  text-align: center;
  font-size: 28rpx;
  padding: 18rpx 12rpx;
  border-radius: 44rpx;
  border: 2rpx solid #ccc;
  color: #777;
  background: #fff;
}
.switch.on {
  border-color: #d4a017;
  background: #fff8e1;
  color: #8a6d00;
  font-weight: 600;
}

.count { font-size: 30rpx; color: #555; margin: 32rpx 0 12rpx; }

.big-btn {
  margin-top: 40rpx;
  height: 108rpx;
  line-height: 108rpx;
  text-align: center;
  border-radius: 54rpx;
  background: #d4a017;
  color: #fff;
  font-size: 38rpx;
  font-weight: 600;
}
.sb-btn {
  margin-top: 24rpx;
  text-align: center;
  font-size: 30rpx;
  color: #888;
  padding: 20rpx;
}

/* 大字版：整体放大 */
.ui-large .page-title { font-size: 52rpx; }
.ui-large .row-text { font-size: 40rpx; }
.ui-large .tip { font-size: 36rpx; }
.ui-large .switch { font-size: 32rpx; min-width: 190rpx; }
