/* ============================================================
   ★ 底部圆圈（11-08 sandy 真机实测定死）
   采访页不再有三按钮（我要插话/别问了/聊完了），只有一个圆圈：
   按住 = 打断 AI，松手 = AI 接着问。
   老人只需要记一件事：「想说就按住它」。
   ============================================================ */
.hold-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding: 16rpx 0 calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to bottom, rgba(245,247,250,0) 0%, rgba(245,247,250,0.96) 30%, rgba(245,247,250,1) 100%);
}

.hold-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--color-accent);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.18);
  transition: transform 0.12s ease, background 0.12s ease;
  -webkit-user-select: none;
  user-select: none;
}

.hold-circle.recording {
  background: #c0392b;
  transform: scale(0.94);
  box-shadow: 0 0 0 12rpx rgba(192, 57, 43, 0.16), 0 6rpx 20rpx rgba(0, 0, 0, 0.18);
}

/* 「聊完了」收成一行小字，不跟圆圈抢位置 */
.finish-link {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8a97a5;
  text-decoration: underline;
  padding: 8rpx 16rpx;
}

/* 页面底部留白，防最后一行被圆圈压住 */
.container, .page { padding-bottom: 260rpx; }


/* ===== ★ 11-10 编导进度骨（sandy：「没有编导」）=====
   一段一格，横向排开，像书的目录。走到哪格亮哪格，走过的打勾。 */
.script-bar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 4rpx;
  padding: calc(var(--space) / 2) 4rpx;
  margin-bottom: calc(var(--space) / 2);
  background: #fff;
  border-radius: 12rpx;
}
.script-step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}
.script-dot {
  width: 40rpx; height: 40rpx; line-height: 40rpx;
  border-radius: 50%;
  text-align: center;
  font-size: 22rpx;
  background: #eee; color: #999;
}
.script-name { font-size: 22rpx; color: #999; margin-top: 6rpx; }
.script-step.done .script-dot { background: #c4956a; color: #fff; }
.script-step.done .script-name { color: #c4956a; }
.script-step.now .script-dot { background: #c4956a; color: #fff; font-weight: 700; box-shadow: 0 0 0 6rpx rgba(196,149,106,.22); }
.script-step.now .script-name { color: #7a5a3a; font-weight: 700; }
.script-step.todo .script-dot { background: #f0ece6; color: #bbb; }

/* 这一段是干什么的：一句话，大字，老人在问句上方先看到它 */
.script-now {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  padding: 10rpx 16rpx;
  margin-bottom: calc(var(--space) / 2);
  background: #fdf6ee;
  border-left: 6rpx solid #c4956a;
  border-radius: 8rpx;
}
.script-now-label { font-size: 22rpx; color: #a08b76; flex: none; }
.script-now-text { flex: 1; font-size: var(--font-base); color: #5a4636; }
.script-left { font-size: 22rpx; color: #a08b76; flex: none; }

/* 大字版：进度骨不缩小，反而更粗更好认 */
.ui-large .script-name { font-size: 26rpx; }
.ui-large .script-dot { width: 52rpx; height: 52rpx; line-height: 52rpx; font-size: 26rpx; }
.ui-large .script-now-text { font-size: var(--font-large, 38rpx); }
