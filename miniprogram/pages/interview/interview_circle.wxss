/* ============================================================
   ★ 底部圆圈（11-08 sandy 真机实测定死）
   采访页不再有三按钮（我要插话/别问了/聊完了），只有一个圆圈：
   按住 = 打断 AI，松手 = AI 接着问。
   老人只需要记一件事：「想说就按住它」。
   ============================================================ */
.hold-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding: 16rpx 0 calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to bottom, rgba(245,247,250,0) 0%, rgba(245,247,250,0.96) 30%, rgba(245,247,250,1) 100%);
}

.hold-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--color-accent);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.18);
  transition: transform 0.12s ease, background 0.12s ease;
  -webkit-user-select: none;
  user-select: none;
}

.hold-circle.recording {
  background: #c0392b;
  transform: scale(0.94);
  box-shadow: 0 0 0 12rpx rgba(192, 57, 43, 0.16), 0 6rpx 20rpx rgba(0, 0, 0, 0.18);
}

/* 「聊完了」收成一行小字，不跟圆圈抢位置 */
.finish-link {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8a97a5;
  text-decoration: underline;
  padding: 8rpx 16rpx;
}

/* 页面底部留白，防最后一行被圆圈压住 */
.container, .page { padding-bottom: 260rpx; }
