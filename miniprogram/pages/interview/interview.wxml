<!--
  pages/interview/interview.wxml —— 采访页（AI 记者对话流 + 可打断 + 归类弹层）
  铁律：老人只用听/说；任何反应都不算错；不确定的地方给「说完了」这种明确按钮，
        不靠猜、不连珠炮、不卡住他。
-->
<view class="container ui-{{uiMode}}">

  <view class="page-title">往事可追忆 · 采访</view>

  <!-- 未登录/无书 -->
  <view wx:if="{{!ownerId}}" class="hint soft">请先登录后再开始</view>

  <block wx:else>
    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="hint">正在准备…</view>

    <!-- 错误（中文人话，可直接看） -->
    <view wx:elif="{{error}}" class="hint error">{{error}}</view>

    <block wx:else>
      <!-- ★ 11-10 sandy 实测：「还是没有把它的结构变了……也没有编导」
           病根：采访页从头到尾只有一个问句卡片，老人不知道①现在讲到哪一段②还剩几段③这段是干什么的。
           改法：最上面加一条【编导进度骨】——像书的目录，一段一格，走到哪格亮哪格；
                标题条下面加一句【这段是干什么的】——由编导脚本给（开场/童年/工作/家庭/晚年）。 -->
      <view class="script-bar">
        <view class="script-step {{item.state}}" wx:for="{{scriptSteps}}" wx:key="key">
          <view class="script-dot">{{item.done ? '✓' : index + 1}}</view>
          <view class="script-name">{{item.name}}</view>
        </view>
      </view>
      <view wx:if="{{scriptNow}}" class="script-now">
        <text class="script-now-label">这一段</text>
        <text class="script-now-text">{{scriptNow}}</text>
        <text class="script-left">还剩 {{scriptLeft}} 段</text>
      </view>

      <!-- 标题条：AI 记者状态 -->
      <view class="stage-bar">
        <text wx:if="{{speaking}}" class="stage-dot on"></text>
        <text wx:elif="{{listening}}" class="stage-dot listen"></text>
        <text class="stage-text">
          {{speaking ? '我在说，您听着' : (listening ? '您说，我听着' : '等一等')}}
        </text>
      </view>

      <!-- 当前问句（大字版更大） -->
      <view class="question-card">
        <view class="q-label" wx:if="{{question.anchor_label}}">关于「{{question.anchor_label}}」</view>
        <view class="q-text">{{question.text || '……'}}</view>
        <view class="q-follow" wx:if="{{question.follow_up}}">{{question.follow_up}}</view>
        <view class="q-hint" wx:if="{{question.audio_hint}}">{{question.audio_hint}}</view>
        <view class="q-resumed" wx:if="{{state === 'resumed'}}">（接着刚才那句问）</view>
      </view>

      <!-- ★打断提示（老人一出声就显示） -->
      <view wx:if="{{bargeTip}}" class="barge-tip">{{bargeTip}}</view>

      <!-- 收声区 ★11-06：真录音（按住说话）。老人按住说 → 松手转文字上屏 → 自动接下一问 -->
      <view wx:if="{{listening}}" class="listen-box">
        <view class="hold-btn {{recording ? 'recording' : ''}} {{answerBusy ? 'busy' : ''}}"
              bindtouchstart="onHoldStart" bindtouchend="onHoldEnd" bindtouchcancel="onHoldCancel">
          {{answerBusy ? (answerStatus || '正在听…') : (recording ? '松开 说完了' : '按住说话')}}
        </view>
        <view wx:if="{{recording}}" class="hold-tip">正在听您说…（{{recSec}} 秒）</view>
        <view wx:elif="{{answerBusy && lastAnswer}}" class="hold-tip">您刚才说的是：{{lastAnswer}}</view>
        <view wx:else class="hold-tip">说完了松手，我记下来</view>
        <!-- 兜底：实在录不上的设备，可以点这里用文字说 -->
        <view class="fallback-row">
          <view class="ghost-btn small" bindtap="onToggleTypeAnswer">{{typeAnswer ? '不用打字了' : '这张嘴不方便，打字说'}}</view>
        </view>
        <block wx:if="{{typeAnswer}}">
          <input class="answer-input" placeholder="想到什么写什么"
                 value="{{lastAnswer}}" bindinput="onAnswerInput" />
          <view class="big-btn" bindtap="onFinishAnswer">说完了</view>
        </block>
      </view>

      <!-- ★ 11-08 定死：三按钮（我要插话/别问了/聊完了）→ 底部一个圆圈
           按住 = 打断 AI，松手 = AI 接着问。老人不用分辨三个功能。 -->
      <view class="hold-dock">
        <view class="hold-circle {{barging ? 'recording' : ''}}"
              bindtouchstart="onCircleStart" bindtouchend="onCircleEnd">
          {{barging ? '说 吧' : '按 住 插 话'}}
        </view>
        <!-- 「聊完了」收到右上角小字，不再占底部（正流程由复述确认自动收尾） -->
        <view class="finish-link" bindtap="onFinishInterview">聊完了</view>
      </view>
    </block>
  </block>

  <!-- ===== 归类弹层（自述页保存后；含 5 秒浮大字按钮） ===== -->
  <view wx:if="{{classifyAsk}}" class="mask" bindtap="onCloseClassify"></view>
  <view wx:if="{{classifyAsk}}" class="sheet" catchtap="noop">
    <view class="sheet-read">这段是新的一件事吗？</view>
    <view class="sheet-ask">{{classifyQ.text}}</view>

    <block wx:if="{{classifyButtonsShown}}">
      <view class="sheet-btn" wx:for="{{classifyQ.buttons}}" wx:key="key"
            bindtap="onTapClassifyButton" data-key="{{item.key}}">{{item.label}}</view>
      <view class="sheet-cancel" bindtap="onCloseClassify">（先不管）</view>
    </block>
    <block wx:else>
      <view class="sheet-ask">您说说就行…（{{classifyQ.buttons.length ? '想不起来就点下面' : ''}}）</view>
      <view class="sheet-btn ghost" bindtap="onClassifyTimeout">想不起来 / 是新的一件事</view>
      <view class="sheet-cancel" bindtap="onCloseClassify">（先不管）</view>
    </block>
  </view>

  <!-- ===== 收尾确认弹层（P0-2 D 组：我这样记，对不对？） ===== -->
  <view wx:if="{{recapAsk}}" class="mask" catchtap="noop"></view>
  <view wx:if="{{recapAsk}}" class="sheet" catchtap="noop">
    <view class="sheet-read">我这样记，对不对？</view>
    <view class="recap-text">{{recapText}}</view>
    <view wx:if="{{recapBusy}}" class="hint">正在记…</view>
    <block wx:else>
      <view class="sheet-btn" bindtap="onRecapAccept">对，就是这样</view>
      <view class="sheet-btn ghost" bindtap="onRecapReject">不太对，再改改</view>
      <view class="sheet-cancel" bindtap="onRecapTimeout">（说不上来，先这样）</view>
    </block>
  </view>

  <!-- ===== 收尾完成 ===== -->
  <view wx:if="{{finished}}" class="mask" catchtap="noop"></view>
  <view wx:if="{{finished}}" class="sheet" catchtap="noop">
    <view class="sheet-read">记下来了</view>
    <view class="sheet-ask">您讲的这段，我给您存好了。</view>
    <view class="sheet-btn" bindtap="onBackHome">回首页</view>
  </view>

</view>
