/* 翻页画册样式 - 像翻一本真正的画册 */
.album-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 加载/空状态 */
.loading-state, .empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  color: var(--text-secondary);
}
.loading-icon, .empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}
.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}
.empty-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 40rpx;
}
.primary-btn {
  background: var(--accent);
  color: #fff;
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
  font-size: 30rpx;
  box-shadow: var(--shadow-soft);
}

/* 画册容器 */
.album-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 30rpx 20rpx 20rpx;
}

/* 书壳 */
.book-shell {
  flex: 1;
  background: linear-gradient(145deg, #8a6a48 0%, #6d5036 100%);
  border-radius: 24rpx;
  padding: 20rpx;
  box-shadow: 0 12rpx 32rpx rgba(58,44,28,0.35), inset 0 0 40rpx rgba(0,0,0,0.2);
}

.pages-swiper {
  height: 100%;
  min-height: 900rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.3);
}

/* 书页 */
.book-page {
  width: 100%;
  height: 100%;
  background: linear-gradient(145deg, #fffdf7 0%, #f7efdf 100%);
  border-radius: 12rpx;
  box-shadow: inset 4rpx 0 12rpx rgba(58,44,28,0.12);
  position: relative;
  overflow: hidden;
}

/* 封面 */
.cover-page {
  display: flex;
  align-items: center;
  justify-content: center;
}
.cover-inner {
  text-align: center;
  padding: 40rpx;
}
.cover-title {
  font-size: 90rpx;
  margin-bottom: 20rpx;
}
.cover-title-text {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--accent-deep);
  letter-spacing: 6rpx;
  margin-bottom: 16rpx;
}
.cover-subtitle {
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-bottom: 40rpx;
  letter-spacing: 4rpx;
}
.cover-meta {
  font-size: 26rpx;
  color: var(--text-muted);
  border-top: 1rpx solid var(--border);
  padding-top: 24rpx;
}

/* 年份内容页 */
.year-page {
  display: flex;
}
.page-gutter-left, .page-gutter-right {
  width: 30rpx;
  flex-shrink: 0;
}
.page-gutter-left {
  box-shadow: inset 2rpx 0 4rpx rgba(58,44,28,0.08);
}
.year-page-inner {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 24rpx 10rpx;
}
.year-head {
  text-align: center;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid var(--accent-light);
  margin-bottom: 16rpx;
}
.year-big {
  font-size: 72rpx;
  font-weight: 800;
  color: var(--accent-deep);
  font-family: Georgia, serif;
}
.year-count {
  font-size: 24rpx;
  color: var(--text-muted);
  display: block;
  margin-top: 4rpx;
}
.page-content-scroll {
  flex: 1;
  height: 640rpx;
}
.page-entry {
  padding: 16rpx 0;
  border-bottom: 1rpx dashed var(--border);
}
.entry-photo {
  text-align: center;
}
.entry-img {
  width: 100%;
  height: 320rpx;
  border-radius: 12rpx;
  box-shadow: var(--shadow-soft);
  background: #eee;
}
.entry-caption {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
  text-align: center;
  font-style: italic;
}
.entry-text {
  padding: 4rpx 0;
}
.entry-date {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 6rpx;
}
.entry-content {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.7;
}
.entry-audio-tag {
  font-size: 24rpx;
  color: var(--accent);
  margin-top: 8rpx;
}
.page-num {
  position: absolute;
  bottom: 16rpx;
  right: 40rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 尾页 */
.end-page {
  display: flex;
  align-items: center;
  justify-content: center;
}
.end-inner {
  text-align: center;
}
.end-title {
  font-size: 40rpx;
  color: var(--accent-deep);
  letter-spacing: 4rpx;
}
.end-subtitle {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-top: 16rpx;
}

/* 底部提示 */
.page-hint {
  text-align: center;
  padding: 16rpx 0 8rpx;
  color: var(--text-secondary);
  font-size: 26rpx;
}
