/* 时间轴样式 */
.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 画册入口 */
.album-entry {
  margin: 24rpx 30rpx 8rpx;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #8a6a48 0%, #6d5036 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 8rpx 24rpx rgba(58,44,28,0.25);
}
.album-entry-left {
  display: flex;
  align-items: center;
}
.album-entry-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}
.album-entry-text {
  display: flex;
  flex-direction: column;
}
.album-entry-title {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}
.album-entry-sub {
  color: rgba(255,255,255,0.75);
  font-size: 24rpx;
  margin-top: 4rpx;
}
.album-entry-arrow {
  color: rgba(255,255,255,0.85);
  font-size: 48rpx;
}

.timeline {
  padding: 0 30rpx;
}

.timeline-year-group {
  margin-bottom: 40rpx;
}

.year-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding-left: 20rpx;
}
.year-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: var(--accent);
  margin-right: 16rpx;
}
.year-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.timeline-story {
  display: flex;
  align-items: flex-start;
  padding-left: 30rpx;
  position: relative;
}
.tl-line {
  width: 4rpx;
  height: 100%;
  background: var(--border);
  position: absolute;
  left: 10rpx;
  top: 0;
}
.timeline-story:last-child .tl-line {
  height: 50%;
}

.tl-card {
  flex: 1;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  margin-left: 20rpx;
  box-shadow: var(--shadow);
}
.tl-date {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-bottom: 6rpx;
}
.tl-era {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  background: var(--accent-light);
  color: var(--accent);
  font-size: 20rpx;
  margin-bottom: 8rpx;
}
.tl-content {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
