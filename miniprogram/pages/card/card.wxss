/* pages/card/card.wxss —— 做成一张图 */
.page-title { font-size: var(--font-title); font-weight: 600; }
.page-sub { color: #666; margin: calc(var(--space) / 3) 0 var(--space); }

.tabs { display: flex; gap: calc(var(--space) / 2); margin-bottom: var(--space); }
.tab {
  flex: 1;
  text-align: center;
  padding: calc(var(--space) / 2) 0;
  border-radius: 12rpx;
  background: #fff;
}
.tab.on { background: var(--color-accent); color: #fff; }

.note {
  background: #fff;
  border-radius: 16rpx;
  padding: var(--space);
  margin-bottom: var(--space);
  color: #666;
}
.note.error { color: #c0392b; }
.note-line { margin-bottom: 6rpx; }
.note-line:last-child { margin-bottom: 0; }
.note-line.warn { color: #b7791f; }

.preview {
  width: 100%;
  border-radius: 16rpx;
  margin-bottom: var(--space);
  background: #faf6f0;
}

.big-btn.hold { opacity: 0.6; }

.sb-btn {
  text-align: center;
  padding: calc(var(--space) / 2);
  color: #666;
  margin-top: calc(var(--space) / 2);
}
.sb-note { color: #999; font-size: 0.85em; margin-top: calc(var(--space) / 2); text-align: center; }
