.tabs { display: flex; gap: calc(var(--space) / 2); margin-bottom: var(--space); }
.tab {
  flex: 1;
  text-align: center;
  padding: calc(var(--space) / 2) 0;
  border-radius: 12rpx;
  background: #fff;
}
.tab.on { background: var(--color-accent); color: #fff; }

.big-btn.recording { background: #c0392b; }

/* ============================================================
   ★ 11-23 修：按住说话圆圈 + 保存键【叠在一起】导致圆圈被完全盖住
   病根：两个都是 position:fixed; bottom:0，保存键是整屏宽横条、
         z-index 相同但后渲染 → 圆圈被压到底下看不见。
         老人点进来只看到「按住说话」四个字和一个「保存」键，
         根本没有可以按的地方 → 录不上 → 保存时报「还没录上」。
   做法：把两者收进同一个吸底容器，竖向排列——圆圈在上、保存键在下，
         一个容器贴底，不再互相遮挡。
   ============================================================ */
.hold-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  padding: 16rpx 0 calc(24rpx + env(safe-area-inset-bottom));
  /* 底色带一点向上渐隐，内容滚到底也不压字 */
  background: linear-gradient(to bottom, rgba(245,247,250,0) 0%, rgba(245,247,250,0.96) 30%, rgba(245,247,250,1) 100%);
}

.hold-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--color-accent);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.18);
  transition: transform 0.12s ease, background 0.12s ease;
  -webkit-user-select: none;
  user-select: none;
}

.hold-circle.recording {
  background: #c0392b;
  transform: scale(0.94);
  box-shadow: 0 0 0 12rpx rgba(192, 57, 43, 0.16), 0 6rpx 20rpx rgba(0, 0, 0, 0.18);
}

/* 有吸底圆圈时给页面留出底部空间，防最后一行被圆圈压住 */
.has-hold-dock { padding-bottom: 260rpx; }

/* ★ 11-23 补：录音中秒数（最小闭环第一步「屏幕出秒数」）。大字、醒目、给老人看得清 */
.rec-timer {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
  font-size: 44rpx;
  font-weight: 600;
  color: #c0392b;
  font-variant-numeric: tabular-nums;
  letter-spacing: 2rpx;
}
.rec-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #c0392b;
  margin-right: 14rpx;
  animation: rec-blink 1s infinite;
}
@keyframes rec-blink {
  0%, 49% { opacity: 1; }
  50%, 100% { opacity: 0.15; }
}

/* ============================================================
   ★ 保存键吸底（2026-11-20 sandy 真机实测，第 N 次）
   病根：保存键在流内、排在「这件事已经有 N 项」后面 →
         内容一多就要往下拉很远才按得到，不打到保存 = 这一整段没存下来。
   做法：与「按住说话」同一套吸底（position:fixed bottom:0），
         用 padding-bottom 给流内内容让位 → 内容再长也不会压住最后一条。
   ⚠️ 首层 .container 不设 padding-top，fixed 直接贴 kou底部，不受影响。
   ============================================================ */
/* ============================================================
   ★ 11-23 修：保存键不再自己吸底，改由 .hold-dock 容器统一管
   病根（2026-11-20 起的真机问题）：保存键自己 position:fixed; bottom:0，
         而「按住说话」圆圈也是 fixed; bottom:0 → 整屏宽的保存键把圆圈
         完全盖住。老人点进「说话」页看到「按住说话，松开就记下了」这行字，
         却找不到任何能按的圆圈 → 按保存时报「还没录上」。
   做法：说话页里保存键放进 .hold-dock 内部、取消 fixed（静态排列），
         圆圈在上、保存键在下，一个容器贴底。
         打字/照片页没有圆圈，保存键仍自己吸底（下面 .save-dock 规则保留）。
   ============================================================ */
.save-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  padding: 16rpx var(--space) calc(16rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to bottom, rgba(245,247,250,0) 0%, rgba(245,247,250,0.97) 26%, rgba(245,247,250,1) 100%);
}
/* ★ 说话页（同时有圆圈）：保存键回到流内，跟圆圈一起被 .hold-dock 贴着 */
.hold-dock .save-dock {
  position: static;
  padding: 12rpx var(--space) 0;
  background: transparent;
}
.save-dock .save-btn {
  width: 100%;
  height: var(--btn-h);
  line-height: var(--btn-h);
  text-align: center;
  font-size: var(--font-base);
  border-radius: 20rpx;
  background: var(--color-accent);
  color: #fff;
  box-shadow: 0 6rpx 18rpx rgba(0,0,0,0.12);
}
/* 打字/照片页给吸底键让位（说话页已有孔，不重复加） */
.has-save-dock { padding-bottom: 220rpx; }
/* 说话页同时有「按住说话」圆圈 + 保存键 → 两个都吸底，保存键在上 */
.has-hold-dock.has-save-dock { padding-bottom: 420rpx; }
.has-hold-dock.has-save-dock .save-dock { padding-bottom: 220rpx; }

.text-input {
  width: 100%;
  min-height: 320rpx;
  padding: var(--space);
  box-sizing: border-box;
  background: #fff;
  border-radius: 12rpx;
  font-size: var(--font-base);
  margin-bottom: var(--space);
}

.media-grid { display: flex; flex-wrap: wrap; gap: calc(var(--space) / 2); }
.media-item {
  position: relative;
  width: 160rpx; height: 160rpx; border-radius: 12rpx; overflow: hidden;
  background: #eee; display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: #666;
}
/* ★ 11-10：真出预览图（原来只渲英文 kind，sandy 报"没预览、点不进去"） */
.media-thumb { width: 100%; height: 100%; display: block; }
.media-thumb-ph { background: #e6e6e6; color: #666; display: flex; align-items: center; justify-content: center; }
.media-badge {
  position: absolute; left: 8rpx; bottom: 8rpx;
  padding: 2rpx 10rpx; border-radius: 8rpx;
  background: rgba(0,0,0,.55); color: #fff; font-size: 20rpx;
}
.media-del {
  position: absolute; right: 0; top: 0;
  width: 44rpx; height: 44rpx; line-height: 44rpx; text-align: center;
  background: rgba(0,0,0,.45); color: #fff; font-size: 30rpx;
  border-bottom-left-radius: 12rpx;
}
.media-empty {
  margin-top: calc(var(--space) / 2);
  font-size: var(--font-small, 26rpx); color: #999;
}
.list-title { font-size: var(--font-base); font-weight: 600; margin: var(--space) 0; }

/* 软提示：灰/黄，不弹红叉（转写稍后 / 建议分段 / 上传通道未开） */
.notice {
  margin: var(--space) 0;
  padding: calc(var(--space) / 2);
  border-radius: 12rpx;
  background: #fdf6e3;
  color: #8a6d00;
  font-size: 26rpx;
  line-height: 1.5;
}
.hint {
  margin-bottom: calc(var(--space) / 2);
  color: #666;
  font-size: 26rpx;
}
.clip-item {
  padding: calc(var(--space) / 2);
  margin-bottom: calc(var(--space) / 2);
  background: #fff;
  border-radius: 12rpx;
  font-size: var(--font-base);
}
.clip-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #666;
  font-size: 26rpx;
}
.clip-dur { color: #999; font-size: 24rpx; }
.clip-text {
  display: block;
  margin-top: 12rpx;
  color: #333;
  line-height: 1.6;
  word-break: break-all;
}
.clip-wait { display: block; margin-top: 12rpx; color: #bbb; font-size: 24rpx; }

/* ★ 三链路①：刚才说的那句话，大字回显（老人一眼看见自己说的变成了字） */
.said {
  margin: var(--space) 0;
  padding: var(--space);
  border-radius: 12rpx;
  background: #eaf5ff;
  border-left: 8rpx solid var(--color-accent);
}
.said-label { font-size: 24rpx; color: #5b7a99; margin-bottom: 8rpx; }
.said-text { font-size: 40rpx; line-height: 1.5; color: #1a1a1a; font-weight: 600; }

/* ★ 三链路②：音频条 —— 一个大按钮 + 跳动的波，老人都认得「▶」 */
.audio-bar {
  display: flex;
  align-items: center;
  padding: calc(var(--space) / 2) 0;
  margin-bottom: calc(var(--space) / 3);
}
/* playable=false：只给灰态，不弹红叉，不劝退老人 */
.audio-bar.grey { opacity: .45; }
.audio-bar.grey .audio-tip { font-size: 26rpx; }
.audio-btn {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  background: var(--color-accent); color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; flex-shrink: 0;
}
.audio-wave {
  flex: 1;
  display: flex; align-items: center; gap: 8rpx;
  height: 60rpx; margin: 0 20rpx;
}
.audio-wave .bar {
  flex: 1; background: #c9d9e8; border-radius: 4rpx; height: 30%;
}
.audio-wave.on .bar { background: var(--color-accent); animation: wave 900ms ease-in-out infinite; }
.audio-wave.on .b1 { height: 30%; animation-delay: 0ms; }
.audio-wave.on .b2 { height: 55%; animation-delay: 90ms; }
.audio-wave.on .b3 { height: 80%; animation-delay: 180ms; }
.audio-wave.on .b4 { height: 45%; animation-delay: 270ms; }
.audio-wave.on .b5 { height: 70%; animation-delay: 360ms; }
.audio-wave.on .b6 { height: 40%; animation-delay: 450ms; }
.audio-wave.on .b7 { height: 75%; animation-delay: 540ms; }
.audio-wave.on .b8 { height: 35%; animation-delay: 630ms; }
@keyframes wave {
  0%, 100% { transform: scaleY(0.6); }
  50%      { transform: scaleY(1.2); }
}
.audio-tip { font-size: 26rpx; color: #666; flex-shrink: 0; }

/* ★ 三链路①：说了什么 —— 转写文字直接上屏，不再是「voice」这种机器话 */
.clip-text { font-size: 32rpx; line-height: 1.55; color: #1a1a1a; }
.clip-text.dim { color: #999; font-size: 26rpx; }
.clip-type { font-size: 26rpx; color: #888; }

/* ★ 做成一张图（次要入口，不抢「保存」的主位） */
.sb-btn {
  margin-top: calc(var(--space) / 2);
  text-align: center;
  padding: var(--space);
  color: var(--color-accent);
  font-size: var(--font-base);
}
