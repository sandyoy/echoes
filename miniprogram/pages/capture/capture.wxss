.tabs { display: flex; gap: calc(var(--space) / 2); margin-bottom: var(--space); }
.tab {
  flex: 1;
  text-align: center;
  padding: calc(var(--space) / 2) 0;
  border-radius: 12rpx;
  background: #fff;
}
.tab.on { background: var(--color-accent); color: #fff; }

.big-btn.recording { background: #c0392b; }

.text-input {
  width: 100%;
  min-height: 320rpx;
  padding: var(--space);
  box-sizing: border-box;
  background: #fff;
  border-radius: 12rpx;
  font-size: var(--font-base);
  margin-bottom: var(--space);
}

.media-grid { display: flex; flex-wrap: wrap; gap: calc(var(--space) / 2); }
.media-item {
  width: 160rpx; height: 160rpx; border-radius: 12rpx;
  background: #eee; display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: #666;
}
.list-title { font-size: var(--font-base); font-weight: 600; margin: var(--space) 0; }

/* 软提示：灰/黄，不弹红叉（转写稍后 / 建议分段 / 上传通道未开） */
.notice {
  margin: var(--space) 0;
  padding: calc(var(--space) / 2);
  border-radius: 12rpx;
  background: #fdf6e3;
  color: #8a6d00;
  font-size: 26rpx;
  line-height: 1.5;
}
.hint {
  margin-bottom: calc(var(--space) / 2);
  color: #666;
  font-size: 26rpx;
}
.clip-item {
  padding: calc(var(--space) / 2);
  margin-bottom: calc(var(--space) / 2);
  background: #fff;
  border-radius: 12rpx;
  font-size: var(--font-base);
}
