<!-- 采集页：3 类素材（说话 / 照片视频 / 打字），素材挂同一件事 -->
<!-- ★ 11-10 sandy 真机实测定死：
     ①「说话」和「留个声」他分不清 → 合成一个「说话」（原声一并留着）
     ②「照片」和「视频」并成一个框（都走图库/相机，不用隔两个入口）
     ③入口从 5 个收到 3 个 -->
<view class="container {{type === 'voice' ? 'has-hold-dock' : ''}}">

  <!-- 类型切换（标准版显示；大字版收起为单一模式） -->
  <view wx:if="{{uiMode !== 'large'}}" class="tabs">
    <view class="tab {{type === 'voice'  ? 'on' : ''}}" data-type="voice" bindtap="onTypeChange">说话</view>
    <view class="tab {{type === 'media'  ? 'on' : ''}}" data-type="media" bindtap="onTypeChange">照片视频</view>
    <view class="tab {{type === 'text'   ? 'on' : ''}}" data-type="text"  bindtap="onTypeChange">打字</view>
  </view>

  <!-- 说话：按住说话（语音→转文字，原声一并留着） -->
  <!-- ⚠️ 铁律（11-08 sandy 真机实测）：按住说话固定屏幕底部，不随内容滚；所有采集页统一 -->
  <block wx:if="{{type === 'voice'}}">
    <view class="hint">按住说话，松开就记下了</view>
    <view class="hold-dock">
      <view class="hold-circle {{recording ? 'recording' : ''}}"
            bindtouchstart="onHoldStart" bindtouchend="onHoldEnd">
        {{recording ? '松 开' : '按住说话'}}
      </view>
    </view>
  </block>

  <!-- 打字 -->
  <block wx:elif="{{type === 'text'}}">
    <textarea class="text-input" placeholder="想到什么就写什么…"
              bindinput="onTextInput" value="{{text}}"></textarea>
  </block>

  <!-- 照片 / 视频：一个框，点加号直接跳图库（当场拍/录 + 相册选） -->
  <block wx:else>
    <view class="big-btn" data-kind="media" bindtap="onPlusPick">+ 添加照片或视频</view>
    <!-- ★ 11-10 修：原来直接渲 {{item.kind}} → 页面露 "video"/"photo" 英文占位。
         现在真出预览图（图片 image / 视频 video），拿不到缩略图就出中文角标 -->
    <view class="media-grid">
      <view wx:for="{{mediaList}}" wx:key="path" class="media-item"
            data-idx="{{index}}" bindtap="onPreviewMedia">
        <image wx:if="{{item.kind === 'image' || item.kind === 'photo'}}"
               class="media-thumb" src="{{item.path}}" mode="aspectFill" />
        <video wx:elif="{{item.kind === 'video'}}" class="media-thumb"
               src="{{item.path}}" controls="{{false}}" show-center-play-btn="{{true}}" />
        <view wx:else class="media-thumb media-thumb-ph">{{item.kind === 'video' ? '视频' : '照片'}}</view>
        <view wx:if="{{item.kind === 'video'}}" class="media-badge">视频</view>
        <view class="media-del" catchtap="onDelMedia" data-idx="{{index}}">×</view>
      </view>
    </view>
    <view wx:if="{{mediaList.length === 0}}" class="media-empty">还没有照片或视频</view>
  </block>

  <!-- ★ 三链路①：刚才那段变成了字，大字回显（老人松开手立刻能看见） -->
  <view wx:if="{{lastTranscript}}" class="said">
    <view class="said-label">你刚才说的是</view>
    <view class="said-text">{{lastTranscript}}</view>
  </view>

  <!-- 软提示（灰/黄，不弹红叉：转写稍后 / 建议分段 / 上传通道未开） -->
  <view wx:if="{{notice}}" class="notice">{{notice}}</view>

  <!-- 已采集素材（挂同一件事）：有声的当场能听、能看转出来的字 -->
  <view wx:if="{{clips.length > 0}}" class="list-title">这件事已经有 {{clips.length}} 项</view>
  <view wx:for="{{clips}}" wx:key="clip_id" class="clip-item">

    <!-- ★ 三链路②：音频条（有声就能听；playable=false 只给灰态，不画红叉） -->
    <view wx:if="{{item.playable}}" class="audio-bar"
          data-id="{{item.clip_id}}" data-url="{{item.media_url}}" bindtap="onTogglePlay">
      <view class="audio-btn">{{item.playing ? '❚❚' : '▶'}}</view>
      <view class="audio-wave {{item.playing ? 'on' : ''}}">
        <view class="bar b1"></view><view class="bar b2"></view><view class="bar b3"></view>
        <view class="bar b4"></view><view class="bar b5"></view><view class="bar b6"></view>
        <view class="bar b7"></view><view class="bar b8"></view>
      </view>
      <view class="audio-tip">{{item.playing ? '正在放' : '听一下'}}</view>
    </view>
    <view wx:elif="{{item.clip_type === 'voice' || item.clip_type === 'audio' || item.clip_type === 'original'}}"
          class="audio-bar grey">
      <view class="audio-btn">▶</view>
      <view class="audio-tip">声音已留着，这会儿放不了</view>
    </view>

    <!-- ★ 三链路①：说了什么（转写文字直接上屏，不再只显示类型名） -->
    <view wx:if="{{item.transcript || item.text}}" class="clip-text">{{item.transcript || item.text}}</view>
    <view wx:elif="{{item.transcribed === false && (item.clip_type === 'voice' || item.clip_type === 'audio')}}"
          class="clip-text dim">文字还在转，等一会儿</view>
    <view wx:elif="{{item.clip_type === 'voice' || item.clip_type === 'audio'}}"
          class="clip-text dim">这段的字还没转好，声音已经留着了</view>
    <view wx:else class="clip-type">{{item.clip_type === 'original' ? '留个声' : item.clip_type}}</view>
  </view>

  <view class="big-btn" bindtap="onSave">保存</view>

  <!-- ★ 做成一张图（10-18 卡片出图通道）：有故事就能做，只放公开素材 -->
  <view wx:if="{{storyId}}" class="sb-btn" bindtap="onOpenCard">把这件事做成一张图</view>
</view>
