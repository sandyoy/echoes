/* 故事详情页（P0-2 · B 组）：字号/间距走全局 CSS 变量，大字版自动放大 */
.s-title {
  font-size: var(--font-title);
  font-weight: 600;
  margin-bottom: calc(var(--space) / 2);
}
.s-time {
  font-size: var(--font-base);
  color: #9a8f83;
  margin-bottom: var(--space);
}
.s-body {
  font-size: var(--font-base);
  line-height: 1.8;
  background: #fff;
  border-radius: 20rpx;
  padding: var(--space);
  white-space: pre-wrap;
  word-break: break-all;
}
.empty, .hint { color: #999; padding: var(--space) 0; }
.err {
  color: #b3423a;
  background: #fff;
  border-radius: 20rpx;
  padding: var(--space);
  margin-bottom: var(--space);
}

.sec-title {
  font-size: var(--font-base);
  font-weight: 600;
  margin: var(--space) 0 calc(var(--space) / 2);
}
.clip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: var(--space);
  margin-bottom: calc(var(--space) / 2);
}
.clip-main { flex: 1 1 0; min-width: 0; }
.clip-type { font-size: var(--font-base); }
.clip-state { font-size: var(--font-base); color: #9a8f83; margin-top: 6rpx; }
.clip-btn {
  flex: none;
  margin-left: var(--space);
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--color-accent);
  color: var(--color-accent);
  font-size: var(--font-base);
}

.btn {
  margin-top: var(--space);
  height: var(--btn-h);
  line-height: var(--btn-h);
  text-align: center;
  border-radius: 20rpx;
  background: var(--color-accent);
  color: #fff;
  font-size: var(--font-base);
}
.btn.ghost {
  background: transparent;
  color: var(--color-accent);
  border: 2rpx solid var(--color-accent);
}
.btn.danger {
  background: #fff;
  color: #b3423a;
  border: 2rpx solid #b3423a;
}
