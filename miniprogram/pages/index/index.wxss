/* 首页样式 */
.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* ===== 顶部问候横幅 ===== */
.hero {
  padding: 56rpx 40rpx 32rpx;
}
.hero-greeting {
  font-size: 46rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 2rpx;
  line-height: 1.3;
}
.hero-sub {
  margin-top: 14rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* ===== 录音区域 ===== */
.recording-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 30rpx 32rpx;
  margin: 10rpx 30rpx 36rpx;
  background: rgba(255,255,255,0.75);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-soft);
  border: 1rpx solid rgba(255,255,255,0.9);
  backdrop-filter: blur(4px);
}
.recording-section .title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}
.recording-section .subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 36rpx;
}

/* 录音按钮 */
.recording-btn-wrapper {
  margin-bottom: 32rpx;
}
.recording-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #fbf6ee, #f0e2cf);
  border: 8rpx solid var(--accent);
  box-shadow: var(--shadow-float), inset 0 2rpx 8rpx rgba(255,255,255,0.9);
  transition: all 0.2s;
  padding: 0;
  line-height: 1;
  position: relative;
}
.recording-btn::after {
  border: none;
}
.recording-btn .icon {
  font-size: 92rpx;
  margin-bottom: 14rpx;
}
.recording-btn .label {
  font-size: 26rpx;
  color: var(--accent-deep);
  font-weight: 500;
}
.recording-btn.recording-active {
  background: linear-gradient(145deg, #f8d9c8, #eebfa4);
  border-color: #e08a52;
  box-shadow: var(--shadow-float);
  animation: pulse 1s infinite;
}
.recording-btn.recording-active .icon {
  animation: blink 1s infinite;
}
@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.06); }
}
@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

/* 模式切换 */
.mode-switch {
  display: flex;
  gap: 18rpx;
}
.mode-btn {
  padding: 18rpx 34rpx;
  border-radius: 50rpx;
  background: #fff;
  border: 2rpx solid var(--border);
  font-size: 27rpx;
  color: var(--text-secondary);
  transition: all 0.2s;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.04);
}
.mode-btn.active {
  background: linear-gradient(135deg, var(--accent), var(--accent-deep));
  border-color: transparent;
  color: #fff;
  font-weight: 500;
  box-shadow: var(--shadow-soft);
}
.mode-btn:active {
  opacity: 0.85;
  transform: scale(0.97);
}

.mode-hint {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 16rpx;
}

.go-interview-btn {
  margin-top: 20rpx;
  width: auto;
  padding: 0 40rpx;
}

/* 转写结果面板 */
.transcript-panel {
  margin: 20rpx 30rpx 0;
  padding: 24rpx 28rpx;
  background: #fff8f0;
  border-radius: var(--radius-md);
  border: 1rpx solid #ffe0c2;
}
.transcript-label {
  font-size: 24rpx;
  color: var(--accent, #ff6b35);
  margin-bottom: 8rpx;
  font-weight: 600;
}
.transcript-text {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.7;
}

/* 文字输入 */
.type-input-area {
  width: 100%;
  padding: 8rpx 30rpx 0;
  box-sizing: border-box;
}
.type-input {
  width: 100%;
  min-height: 220rpx;
  padding: 26rpx;
  background: #fff;
  border-radius: var(--radius-md);
  border: 2rpx solid var(--border);
  font-size: 29rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  line-height: 1.7;
}
.submit-btn {
  margin-top: 22rpx;
  width: 100%;
}

/* ===== 最近回忆区域 ===== */
.recent-section {
  padding: 0 30rpx;
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.section-title::before {
  content: "";
  width: 8rpx;
  height: 30rpx;
  border-radius: 8rpx;
  background: linear-gradient(180deg, var(--accent), var(--accent-deep));
}
.section-more {
  font-size: 26rpx;
  color: var(--accent);
}

/* 故事卡片 */
.story-card {
  background: rgba(255,255,255,0.92);
  border-radius: var(--radius-md);
  padding: 26rpx 28rpx;
  margin-bottom: 18rpx;
  box-shadow: var(--shadow-soft);
  border: 1rpx solid rgba(255,255,255,0.85);
  transition: transform 0.15s;
}
.story-card:active {
  transform: scale(0.99);
}
.story-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}
.story-tag {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: var(--accent-light);
  color: var(--accent-deep);
  font-size: 24rpx;
  font-weight: 500;
}
.story-date {
  font-size: 24rpx;
  color: var(--text-muted);
}
.story-content {
  font-size: 29rpx;
  color: var(--text-primary);
  line-height: 1.8;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

/* 录音提示 Toast */
.recording-toast {
  position: fixed;
  bottom: 230rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(40,30,20,0.85);
  color: #fff;
  padding: 24rpx 48rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 28rpx;
  opacity: 0;
  transition: opacity 0.25s;
  pointer-events: none;
  z-index: 999;
  box-shadow: var(--shadow-float);
}
.recording-toast.show {
  opacity: 1;
}
.toast-icon {
  font-size: 34rpx;
  animation: blink 1s infinite;
}
