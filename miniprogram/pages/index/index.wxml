<!-- 首页：标准版 / 大字版 同一模板，靠 uiMode 分支 -->
<view class="container">

  <!-- ===== 大字版：就一个大按钮「按住说话」 ===== -->
  <block wx:if="{{uiMode === 'large'}}">
    <view class="big-btn hold"
          bindtouchstart="onHoldStart"
          bindtouchend="onHoldEnd">
      按住说话
    </view>
    <!-- 核心之外全部收起；切换/更多藏在「更多」里，不露出「设置/权限/分享」字样（v2.4 §3.3） -->
    <view class="more" bindtap="onToggleMode">更多</view>
  </block>

  <!-- ===== 标准版：两门（我自己说 / 让人问我）+ 故事列表 + 成书 ===== -->
  <block wx:else>
    <view class="title">往事可追忆</view>

    <!-- 「有 N 篇故事提到了你」——登录后由后端算（claim/login 返回 mentioned_count）
         N>0 才显示；整块可点，进待认领页（被提到的人看那篇永远不需要授权） -->
    <view wx:if="{{mentionedCount > 0}}" class="notice" bindtap="onOpenMentioned">
      有 {{mentionedCount}} 篇故事提到了你
    </view>

    <!-- ★ 首页两门（v3.0 §6.0）：上层是「两种写故事的姿态」，进门即模式，不给老人做选择题 -->
    <!-- 门1：我自己说 = 自述 → 走四种录法（下层） -->
    <view class="door">
      <view class="door-title">我自己说</view>
      <view class="door-sub">想到啥说啥，都记下来</view>
      <view class="big-btn" data-type="voice" bindtap="onCapture">说话</view>
      <view class="row">
        <view class="big-btn small" data-type="text"  bindtap="onCapture">写文字</view>
        <view class="big-btn small" data-type="photo" bindtap="onCapture">拍照片</view>
        <view class="big-btn small" data-type="video" bindtap="onCapture">拍视频</view>
      </view>
    </view>

    <!-- 门2：让人问我 = 采访 → 直接进对话框（AI 问-老人答，只有语音，v3.0 §7.1） -->
    <view class="door">
      <view class="door-title">让人问我</view>
      <view class="door-sub">有人一问一答，想起来的更多</view>
      <view class="big-btn" bindtap="onOpenInterview">开始采访</view>
    </view>

    <view class="big-btn" bindtap="onOpenBook">我要成书</view>

    <!-- 故事列表占位（数据主体=故事，v2.4 §2.1） -->
    <view class="list-title">我的故事</view>
    <view wx:if="{{stories.length === 0}}" class="empty">还没有故事，先录一段吧</view>
    <view wx:for="{{stories}}" wx:key="id" class="story-item" data-story-id="{{item.id}}" bindtap="onTapStory">{{item.title}}</view>

    <!-- 时间轴（灵魂功能，v3.0 §五）：目录，看故事排在哪 -->
    <view class="switch" bindtap="onOpenTimeline">看时间轴</view>
    <view class="switch" bindtap="onToggleMode">切换大字版</view>
  </block>

</view>
