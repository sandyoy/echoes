<!-- 首页：标准版 / 大字版 同一模板，靠 uiMode 分支
     标准版结构依据：docs/事卷/原型图/首页定稿_候选A_柔和版.png（sandy 已拍板候选A，小鲸鱼 10-22 03:0x 入库 commit af961e71）
     铁律（sandy 原话）：三块平级同大同形，靠颜色分；禁止把功能按钮竖着罗列当首页。 -->
<view class="container">

  <!-- ===== 大字版：就一个大按钮「按住说话」 ===== -->
  <block wx:if="{{uiMode === 'large'}}">
    <view class="big-btn hold"
          bindtouchstart="onHoldStart"
          bindtouchend="onHoldEnd">
      按住说话
    </view>
    <!-- 核心之外全部收起；切换/更多藏在「更多」里，不露出「设置/权限/分享」字样（v2.4 §3.3） -->
    <view class="more" bindtap="onToggleMode">更多</view>
  </block>

  <!-- ===== 标准版：候选A 柔和版三块卡 ===== -->
  <block wx:else>

    <!-- 顶部：标题 + 副标 + 右上角头像 -->
    <view class="hero">
      <view class="hero-text">
        <view class="title">往事可追忆</view>
        <view class="subtitle">说说您这一辈子，家里人也能听着</view>
      </view>
      <view class="avatar" bindtap="onOpenAvatar">{{avatarText}}</view>
    </view>

    <!-- 登录失败提示条（2026-10-27）：不再让用户点了没反应，直接说原因 + 可点重试 -->
    <view wx:if="{{loginError}}" class="login-err" bindtap="onRetryLogin">
      登录没成功：{{loginError}}
      <text class="login-err-retry">点这里重试</text>
    </view>

    <!-- 自测面板（2026-10-27）：把登录全过程摊开，自己看哪一步断了，不用连电脑 -->
    <view class="diag-toggle" bindtap="onToggleDiag">{{showDiag ? '收起自测' : '看自测过程'}}</view>
    <view wx:if="{{showDiag}}" class="diag-box">
      <view wx:for="{{diagLines}}" wx:key="index" class="diag-line">{{item}}</view>
      <view class="diag-copy" bindtap="onCopyDiag">复制全部</view>
    </view>

    <!-- 「有 N 篇故事提到了你」——N>0 才显示；整块可点，进待认领页 -->
    <view wx:if="{{mentionedCount > 0}}" class="notice" bindtap="onOpenMentioned">
      有 {{mentionedCount}} 篇故事提到了你
    </view>

    <!-- 主区三块：橙卡「自己说」/ 青卡「有人问我」/ 第三块拆「时间轴」+「我的书」两小卡
         三块视觉平级（同大同形），颜色只用来区分，不用大小区分主次 -->
    <view class="cards">
      <!-- 卡1 · 橙 · 自己说 -->
      <view class="card card-orange" bindtap="onCaptureVoice">
        <view class="card-title">自己说</view>
        <view class="card-sub">想到啥说啥，按住就说</view>
        <view class="card-btn">现在就说</view>
      </view>

      <!-- 卡2 · 青 · 有人问我 -->
      <view class="card card-teal" bindtap="onOpenInterview">
        <view class="card-title">有人问我</view>
        <view class="card-sub">我一问，您就想起来了</view>
        <view class="card-btn">开始聊</view>
      </view>

      <!-- 卡3 · 同一个格子里并排两张小卡 -->
      <view class="card card-pair">
        <view class="mini mini-warm" bindtap="onOpenTimeline">
          <view class="mini-title">时间轴</view>
          <view class="mini-sub">看看故事排在哪</view>
        </view>
        <view class="mini mini-soft" bindtap="onOpenBook">
          <view class="mini-title">我的书</view>
          <view class="mini-sub">这一辈子，成一本书</view>
        </view>
      </view>
    </view>

    <!-- 我的故事（数据主体=故事，v2.4 §2.1）；详情页 pages/story -->
    <view class="list-title">我的故事</view>
    <view wx:if="{{stories.length === 0}}" class="empty">还没有故事，先录一段吧</view>
    <view wx:for="{{stories}}" wx:key="id" class="story-item" data-story-id="{{item.id}}" bindtap="onTapStory">{{item.title}}</view>

    <view class="switch" bindtap="onToggleMode">切换大字版</view>
  </block>

</view>
