/* 全局样式 - 苏格拉底学伴 */
page {
  --bg-primary: #f8f6ff;
  --text-primary: #2f2a4a;
  --text-secondary: #6f6a8a;
  --text-muted: #a9a5c0;
  --accent: #6a5acd;
  --accent-light: #e9e6fa;
  --border: #e3e0f0;
  --shadow: 0 2px 8px rgba(0,0,0,0.06);
  
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  background-color: var(--bg-primary);
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.6;
}

/* 通用卡片 */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 20rpx 30rpx;
  box-shadow: var(--shadow);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  color: var(--text-muted);
}
.empty-state .icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}
.empty-state .text {
  font-size: 28rpx;
  text-align: center;
  line-height: 1.8;
}
